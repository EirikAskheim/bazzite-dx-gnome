[Unit]
Description=Mudfish Cloud VPN headless daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# mudfish-run.sh keeps "Auto Connect" enabled and signs in at boot when
# /etc/mudfish/credentials exists (see `ujust mudfish-setup`), so Mudfish
# connects without touching the web UI.
ExecStart=/usr/libexec/mudfish-run.sh
Restart=on-failure
RestartSec=5
# /opt is read-only at runtime; state/logs live under the /var symlink
WorkingDirectory=/var/lib/mudfish

[Install]
WantedBy=multi-user.target
