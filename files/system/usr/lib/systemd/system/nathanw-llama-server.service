[Unit]
Description=Nathanw llama-server (Strix Halo Vulkan, portable tarball)
Documentation=https://github.com/Nathanw1014/strix-halo-llamacpp
After=network-online.target
Wants=network-online.target
# The model tree (~100 GiB) is downloaded after first boot with
# `ujust nathanw-models-download`, which also writes the sentinel below.
# Without it the service would only crash-loop on a fresh image, and it is
# therefore never preset-enabled (see docs/nathanw.md).
ConditionPathExists=/var/lib/nathanw/.models-ready

[Service]
Type=simple
User=nathanw
Group=nathanw
SupplementaryGroups=render video
WorkingDirectory=/var/lib/nathanw
StateDirectory=nathanw
StateDirectoryMode=0750
Environment=HOME=/var/lib/nathanw
# Baked-in defaults; /etc/nathanw/llama-server.conf (written by
# `ujust nathanw-models-download`) overrides them without editing this unit,
# so model switches survive image updates.
Environment=MODEL=/var/lib/nathanw/models/Qwen3.8-Flash-Next/Qwen3.8-Flash-Next-AD-4.27bpw-Q4_K_M-M64/Qwen3.8-Flash-Next-AD-4.27bpw-Q4_K_M-M64-00001-of-00033.gguf
Environment=EXTRA_ARGS=
# 8082, not 8080: signal-cli's user daemon and Steam's CEF debug forward
# already claim 8080 on this box. Override per-host via PORT= in
# /etc/nathanw/llama-server.conf.
Environment=PORT=8082
EnvironmentFile=-/etc/nathanw/llama-server.conf
# Do NOT set VK_ICD_FILENAMES, VK_DRIVER_FILES, or LD_LIBRARY_PATH here.
# The _run wrapper behind /usr/lib/nathanw/vulkan/llama-server pins all of
# them to the bundled Mesa RADV driver; overriding them (as ollama.service
# does for the host ICD) would silently drop the tuned driver this build
# ships. Only the host Vulkan loader and /dev/dri access are required.
# The unit execs /usr/libexec/nathanw-run.sh instead of llama-server
# directly: systemd does not word-split ${EXTRA_ARGS} expanded in
# ExecStart= (it would arrive as one argv element and the server dies
# with `error: invalid argument: -md ... --mmproj ...`), while the
# wrapper lets the shell split it. Flags stay in the wrapper; only the
# model paths come from the environment below.
ExecStart=/usr/libexec/nathanw-run.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
